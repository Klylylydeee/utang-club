MONGODB_URI=mongodb://127.0.0.1:27017/utang-club

# Sign-in (README → Sign-in). Both come from `pnpm hash-password`.
# Replacing AUTH_PASSWORD_HASH changes the password and signs out every device.
AUTH_PASSWORD_HASH=
# At least 32 random characters. Used only to hash client IPs for login throttling.
AUTH_SECRET=

# Optional: extra hostnames allowed to load dev assets (comma-separated).
# This machine's LAN IPs are detected automatically.
DEV_ALLOWED_ORIGINS=

# Optional: tunnel/reverse-proxy hosts allowed to call Server Actions.
ACTION_ALLOWED_ORIGINS=
